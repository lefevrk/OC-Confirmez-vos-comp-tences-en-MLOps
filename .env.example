# MLflow connection
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_TRACKING_USERNAME=replace_with_mlflow_username
MLFLOW_TRACKING_PASSWORD=replace_with_mlflow_password

# PostgreSQL prediction-event storage — points at the compose Postgres
# service's published port; overridden to the in-network hostname for the
# containerized API in compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_scoring

# Registered serving model
MODEL_NAME=credit_scoring
MODEL_ALIAS=champion

# Logging
LOG_LEVEL=INFO

# API authentication — leave empty to disable (local development)
API_TOKEN=
